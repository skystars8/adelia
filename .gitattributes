* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.lock text eol=lf
*.service text eol=lf
*.conf text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
generated/.gitkeep text eol=lf
data/uploads/.gitkeep text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
