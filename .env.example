# Local development. The Windows and Linux setup scripts create .env automatically.
DATABASE_URL=postgres://adelia_app:replace-with-a-random-password@localhost:5432/adelia_dev
APP_SECRET=replace-me
BIND_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DEVELOPMENT_MODE=true
SITE_TITLE=Adelia
SITE_SUBTITLE=Independent discussion for hobby and educational communities

# Keep false for direct Windows development. Enable secure cookies behind HTTPS.
SECURE_COOKIES=false

DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=20
# Static pages are generated outside request handlers by this many workers.
PUBLISHER_WORKERS=2
# Bound expensive multipart/image and Argon2 work during traffic spikes.
POST_CONCURRENCY=32
PASSWORD_CONCURRENCY=4
MAX_UPLOAD_BYTES=8388608
MAX_BODY_CHARS=20000
SESSION_HOURS=12
GENERATED_DIR=generated
UPLOAD_DIR=data/uploads
TEMPLATE_DIR=app_templates
ASSET_DIR=web/assets
RUST_LOG=adelia=info,tower_http=info
